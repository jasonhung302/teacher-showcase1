# 複製為 .env 後修改。正式環境務必設定 SECRET_KEY 與 COOKIE_SECURE=1
# 產生金鑰：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=請改成一組很長的隨機字串

SITE_NAME=智慧教室 教師數位課程展示平台
SITE_TAGLINE=看見每一位老師的數位教學創新
BASE_URL=https://teacher.example.edu.tw

# HTTPS 上線後設為 1（Cookie 只走 HTTPS、開啟 HSTS）
COOKIE_SECURE=0
# 放在 Nginx 等反向代理後面時設為 1
TRUST_PROXY=0

# 資料與上傳檔位置（預設為專案下 instance/）
# INSTANCE_DIR=/var/lib/teacher-showcase

# 上傳限制（MB）
IMAGE_MAX_MB=5
PDF_MAX_MB=20

# Session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# 寄信（忘記密碼）。未設定 SMTP_HOST 時，重設連結會印在伺服器 log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.edu.tw
SMTP_USE_TLS=1
